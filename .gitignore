# .gitignore

# Latexmk products
*.pdf
# the xref table Overleaf's pre/post-process hooks extract next to the PDF
*.pdfxref

# knitr products: the .tex and the concordance file are generated from the
# .Rnw/.Rtex next to them (tests/knitr)
*-concordance.tex
tests/knitr/*.tex

# TeX Files
__latexindent_temp.tex
_minted*
*.aux
*.auxlock
*.bbl
*.bbox
*.bcf
*.blg
*.count
*.dep
*.dpth
*.dvi
*.xdv
*.eps
*.fdb_latexmk
*.fls
*.gaux
*.glog
*.glsdefs
*.gtex
*.list
*.lof
*.log
*.lol
*.lot
*.md5
*.nav
*.out
*.pdf_tex
*.pyg
*.snm
*.synctex.gz
*.synctex(busy)
*.tdo
*.toc
*.vrb
*.xml
tests/*/subdir/
