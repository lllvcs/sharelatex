extends ../layout-website-redesign

block vars
	- isWebsiteRedesign = true

block content
	//- The password step that links an existing account to single sign-on.
	//- Reached by an OIDC login whose email address matches an account that is
	//- not linked yet (see OidcLinkRequest.mjs).
	main#main-content.content
		.container
			.row
				.col-lg-6.offset-lg-3.col-xl-4.offset-xl-4
					.page-header
						h1 Link this account to single sign-on
					if oidc_error_message
						.alert.alert-danger(role='alert') #{oidc_error_message}
					p.
						The identity provider confirmed the email address below, and an
						Overleaf account already uses it. Enter the password of that account
						to link it to single sign-on. From then on, single sign-on signs you in.
					form(name='oidcLinkForm' action='/login/oidc/link' method='POST')
						input(name='_csrf' type='hidden' value=csrfToken)
						.form-group
							label(for='email') #{translate("email")}
							input#email.form-control(
								name='email'
								type='email'
								value=oidc_link_email
								required
								autocomplete='username'
							)
						.form-group
							label(for='password') #{translate("password")}
							input#password.form-control(
								name='password'
								type='password'
								autocomplete='current-password'
								autofocus='true'
								required
							)
						.actions
							button.btn-primary.btn(type='submit') #{translate("login")}
							a.float-end(href='/login') Back to log in
